  "examples": [
    {
      "description": "Install Kubex Tools - Kbx",
      "code": "kubex module install kbx"
    },
    {
      "description": "View logs from all applications",
      "code": "kbx view --all"
    },
    {
      "description": "Search logs for a specific keyword",
      "code": "kbx search --keyword 'error'"
    }
  ]
